# Copy to .env and fill in. Never commit .env.

# --- LLM provider: ollama | gemini | mock ---
PP_LLM_PROVIDER=mock

# Ollama runs natively on the Windows host (NOT in Docker).
# From the host:            http://localhost:11434
# From inside a container:  http://host.docker.internal:11434
PP_OLLAMA_BASE_URL=http://localhost:11434
PP_OLLAMA_MODEL=qwen2.5-coder:7b

# Gemini API free tier (https://aistudio.google.com/apikey)
PP_GEMINI_API_KEY=
PP_GEMINI_MODEL=gemini-2.5-flash

# --- Observability profile (Langfuse). Replace every CHANGEME. ---
# Generate: NEXTAUTH_SECRET/SALT -> 32+ random chars; ENCRYPTION_KEY -> 64 hex chars
LANGFUSE_NEXTAUTH_SECRET=CHANGEME
LANGFUSE_SALT=CHANGEME
LANGFUSE_ENCRYPTION_KEY=CHANGEME_64_HEX_CHARS
LANGFUSE_POSTGRES_PASSWORD=CHANGEME
LANGFUSE_CLICKHOUSE_PASSWORD=CHANGEME
LANGFUSE_REDIS_AUTH=CHANGEME
LANGFUSE_MINIO_PASSWORD=CHANGEME
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Compose-only: how the api container reaches host Ollama
PP_OLLAMA_BASE_URL_IN_DOCKER=http://host.docker.internal:11434
