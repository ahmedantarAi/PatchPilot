# Copy to .env and fill in. Never commit .env.

# --- LLM provider: ollama | gemini | mock ---
PP_LLM_PROVIDER=mock

# Ollama runs natively on the Windows host (NOT in Docker).
# From the host:            http://localhost:11434
# From inside a container:  http://host.docker.internal:11434
PP_OLLAMA_BASE_URL=http://localhost:11434
PP_OLLAMA_MODEL=qwen2.5-coder:7b

# Gemini API free tier (https://aistudio.google.com/apikey). Free tier: your prompts may be used by
# Google, so NEVER send private code (SPEC section 9).
# Model names change; checked against ai.google.dev/gemini-api/docs/pricing on 2026-10-31.
# Free-tier text models listed there: gemini-3.8-flash, gemini-3.6-flash, gemini-3.5-flash-lite,
# gemini-3.1-flash-lite, gemini-2.5-flash-lite (2.5 family may be limited to projects that already used it).
PP_GEMINI_API_KEY=
PP_GEMINI_MODEL=gemini-3.8-flash

# Optional, only if a container ever needs host Ollama (nothing does today; see SPEC section 4):
# set OLLAMA_HOST=0.0.0.0:11434 on the host. WARNING: exposes Ollama (no auth) to your LAN; add a
# Windows Firewall rule limiting 11434 to the Docker/WSL subnet first.

# --- Observability profile (Langfuse). Replace every CHANGEME. ---
# Generate: NEXTAUTH_SECRET/SALT -> 32+ random chars; ENCRYPTION_KEY -> 64 hex chars
LANGFUSE_NEXTAUTH_SECRET=CHANGEME
LANGFUSE_SALT=CHANGEME
LANGFUSE_ENCRYPTION_KEY=CHANGEME_64_HEX_CHARS
LANGFUSE_POSTGRES_PASSWORD=CHANGEME
LANGFUSE_CLICKHOUSE_PASSWORD=CHANGEME
LANGFUSE_REDIS_AUTH=CHANGEME
LANGFUSE_MINIO_PASSWORD=CHANGEME
LANGFUSE_PUBLIC_KEY=pk-lf-local-patchpilot
LANGFUSE_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_HOST=http://localhost:3000

# Headless Langfuse bootstrap on first `obs-up` (D-26):
LANGFUSE_INIT_ORG_ID=patchpilot-org
LANGFUSE_INIT_ORG_NAME=PatchPilot
LANGFUSE_INIT_PROJECT_ID=patchpilot
LANGFUSE_INIT_PROJECT_NAME=PatchPilot
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local-patchpilot
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_INIT_USER_EMAIL=admin@patchpilot.local
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME

